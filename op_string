# operasi dan manipulasi string

# 1. menyambung string (concatenate)
nama_pertama = "ucup"
nama_tengah = "D"
nama_terakhir = "Fame"

nama_lengkap = nama_pertama + " " + nama_tengah + "'" + nama_terakhir
print(nama_lengkap)

# 2. menghitung panjang dari string
panjang = len(nama_lengkap)
print("panjang dari" + nama_lengkap + " = " + str(panjang))

# 3. operator untuk string

# mengecek apakah ada komponen char atau string di string

d = "d"
status = d in nama_lengkap
print(d + " ada di " + nama_lengkap + " = " + str(status)) # llowercase sama uppercase hrs diperhatikan

D = "D"
status = D in nama_lengkap
print(D + " ada di " + nama_lengkap + " = " + str(status)) # llowercase sama uppercase hrs diperhatikan

d = "d"
status = d not in nama_lengkap
print(d + " tidak ada di " + nama_lengkap + " = " + str(status)) # llowercase sama uppercase hrs diperhatikan

# mengulang string
print("wk"*10)
print(15*"wk")

# indexing (mengambil data dari string)
print("index ke-0 : "+ nama_lengkap[0])
print("index ke-1 : "+ nama_lengkap[1])
print("index ke-6 : "+ nama_lengkap[6])
print("index ke-(-2) : "+ nama_lengkap[-2])
print("index ke-(0:3) : "+ nama_lengkap[0:3]) # : adalah sampai, jadinya huruf yang terakhir gak diambil
print("index ke-(3:7) : "+ nama_lengkap[3:8]) # harus dilebihin kalo mau narget
print("index ke-(0,2,4,6,8,10) : "+ nama_lengkap[0:10:2]) # ngambil dari 0 sampai 10 diloncati 2

# item paling kecil (urutan abjad huruf)
print("paling kecil :" + min(nama_lengkap))
# item paling besar (urutan abjad huruf)
print("paling besar :" + max(nama_lengkap))

# ngambil ascii code 
ascii_code = ord(" ") # untuk mngambil one chr string
print("ASCII code untuk spasi adalah " + str(ascii_code))
data = 117
print("char untuk ASCII 117 adalah " + chr(data))

# 4. operator dalam bentuk method (kalo method nempel di stringnya)
data = "otong surotong pararotong"
jumlah = data.count("o") # ada dot nya, nempel berarti ada objeknya
print("jumlah o pada data " + data + " = " + str(jumlah ))